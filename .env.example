# LIVE deployment: 5 USDT margin x 5 leverage = about 25 USDT notional.
COINDCX_API_KEY=
COINDCX_API_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=/app/sessions/xau
TELEGRAM_CHANNEL_ID=-1001496382172
TRADE_MARGIN_USDT=5
LEVERAGE=5
DRY_RUN=false
TRADING_ENABLED=true
