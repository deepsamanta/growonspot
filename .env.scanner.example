# Existing .env supplies CoinDCX and Telegram credentials. Never duplicate them here.
SCANNER_ENABLED=true
SCANNER_DATABASE=/app/scanner-data/scanner.sqlite3
SCANNER_DAY_TIMEZONE=Asia/Kolkata
SCANNER_LONG_MARGIN_CAP=6.50
SCANNER_SCAN_SECONDS=300
SCANNER_SHORT_DISTANCE=0.10
SCANNER_SHORT_LIMIT_SECONDS=14400
SCANNER_HEALTH_PORT=8081
SCANNER_WEBSOCKET_ENABLED=true
# Additional CoinDCX-only ATH breakout / 35% fifteen-minute candle short rule.
SCANNER_ATH_SHORT_ENABLED=true
SCANNER_ATH_SCAN_SECONDS=30
